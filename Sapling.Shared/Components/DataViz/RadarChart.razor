@namespace Sapling.Shared.Components

@{
    var width = Size * 1.3;
    var cx = width / 2;
    var cy = Size / 2.0;
    var r = (Size / 2.0) - VerticalPadding;
    var n = Math.Max(Axes.Count, 3);
}

<svg width="100%" viewBox="0 0 @width.ToString("0.#") @Size" role="img" aria-label="Skill radar" style="max-width:@(width.ToString("0.#"))px">
    @for (var ring = 1; ring <= Rings; ring++)
    {
        var rr = r * ring / Rings;
        <polygon points="@Polygon(cx, cy, rr, n, _ => 1.0)" fill="none" stroke="var(--line)" stroke-width="1" />
    }

    @for (var i = 0; i < n; i++)
    {
        var (x, y) = Point(cx, cy, r, i, n);
        <line x1="@cx.ToString("0.#")" y1="@cy.ToString("0.#")" x2="@x.ToString("0.#")" y2="@y.ToString("0.#")" stroke="var(--line)" stroke-width="1" />
    }

    @foreach (var (series, index) in Series.Select((s, i) => (s, i)))
    {
        var colour = $"var(--viz-{(index % 5) + 1})";
        <polygon points="@Polygon(cx, cy, r, n, i => Ratio(series.Values, i))"
                 fill="@colour" fill-opacity="@(index == 0 ? "0.18" : "0.10")"
                 stroke="@colour" stroke-width="2" stroke-linejoin="round" />
    }

    @((MarkupString)AxisLabels(cx, cy, r, n))
</svg>

@code {
    public sealed record RadarSeries(string Name, IReadOnlyList<double> Values);

    [Parameter, EditorRequired] public IReadOnlyList<string> Axes { get; set; } = [];

    [Parameter, EditorRequired] public IReadOnlyList<RadarSeries> Series { get; set; } = [];

    [Parameter] public int Size { get; set; } = 300;

    [Parameter] public int Rings { get; set; } = 4;

    [Parameter] public double Max { get; set; } = 100;

    private const double VerticalPadding = 34;
    private const double LabelGap = 12;
    private const int MaxLabelChars = 12;

    private static (double X, double Y) Point(double cx, double cy, double radius, int index, int count)
    {
        var angle = (2 * Math.PI * index / count) - (Math.PI / 2);
        return (cx + (radius * Math.Cos(angle)), cy + (radius * Math.Sin(angle)));
    }

    private double Ratio(IReadOnlyList<double> values, int index) =>
        index < values.Count ? Math.Clamp(values[index] / Max, 0, 1) : 0;

    private static string Polygon(double cx, double cy, double radius, int count, Func<int, double> scale)
    {
        var parts = new string[count];
        for (var i = 0; i < count; i++)
        {
            var (x, y) = Point(cx, cy, radius * scale(i), i, count);
            parts[i] = $"{x:0.#},{y:0.#}";
        }

        return string.Join(' ', parts);
    }

    // Razor reserves the <text> tag, so axis labels are emitted as raw SVG markup.
    private string AxisLabels(double cx, double cy, double r, int count)
    {
        var sb = new System.Text.StringBuilder();
        for (var i = 0; i < count; i++)
        {
            var (lx, ly) = Point(cx, cy, r + LabelGap, i, count);
            var anchor = Math.Abs(lx - cx) < 4 ? "middle" : lx > cx ? "start" : "end";
            var text = Axes[i].Length > MaxLabelChars ? Axes[i][..(MaxLabelChars - 1)].TrimEnd() + "\u2026" : Axes[i];
            var label = System.Net.WebUtility.HtmlEncode(text);
            sb.Append($"""<text x="{lx:0.#}" y="{ly:0.#}" text-anchor="{anchor}" dominant-baseline="middle" font-family="var(--font-body)" font-size="11" fill="var(--subtle)">{label}</text>""");
        }

        return sb.ToString();
    }
}
