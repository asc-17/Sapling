@page "/skills"
@namespace Sapling.Shared.Pages
@inject ISkillGapService Gaps
@inject IProfileService Profiles

<PageTitle>Skills &amp; gaps · Sapling</PageTitle>
<RecordVisit Feature="@FeatureCatalog.SkillGap" />

<div class="stack g-5">
    <div class="page-head">
        <div class="stack g-1">
            <h1 style="font-size:28px;line-height:34px">Skills &amp; gaps</h1>
            <span class="t-muted">
                @(_radar is null ? "Measured against live job descriptions." : $"Measured against {_radar.RoleName} job descriptions.")
            </span>
        </div>
        <SapSegmented TValue="string" Options="_views" @bind-Value="_view" />
    </div>

    @if (_gaps is null)
    {
        <div class="card"><div class="skeleton" style="height:240px"></div></div>
    }
    else if (_view == "radar")
    {
        <div class="grid grid-2">
            <div class="card stack center g-4">
                @if (_radar is not null)
                {
                    <RadarChart Axes="_radar.Axes" Size="320" Series="Series" />
                    <div class="row g-4 wrap center">
                        <span class="row g-2 t-caption"><i style="width:10px;height:10px;border-radius:2px;background:var(--viz-1)"></i> @_radar.RoleName needs</span>
                        <span class="row g-2 t-caption"><i style="width:10px;height:10px;border-radius:2px;background:var(--viz-2)"></i> You, verified</span>
                    </div>
                }
            </div>

            <SapCard Title="Your skills" Subtitle="Claimed skills help matching; verified skills move your score">
                <ChildContent>
                    <div class="row g-2 wrap">
                        @foreach (var skill in _skills)
                        {
                            <span class="chip @(skill.Verified ? "chip-verified" : "chip-claimed")" title="@skill.Source">
                                @if (skill.Verified)
                                {
                                    <SapIcon Name="check" Size="13" Stroke="2.5" />
                                }
                                @skill.Name
                            </span>
                        }
                    </div>
                </ChildContent>
                <Footer>
                    <span class="t-caption t-subtle">
                        @_skills.Count(s => s.Verified) verified &middot; @_skills.Count(s => !s.Verified) claimed
                    </span>
                    <a class="btn btn-secondary btn-sm" href="/onboarding/skills">Edit skills</a>
                </Footer>
            </SapCard>
        </div>
    }

    <div class="stack g-3">
        <span class="t-overline t-subtle">@(_view == "radar" ? "Gaps, ranked by impact" : "Impact against effort")</span>
        @if (_gaps is not null)
        {
            <div class="stack g-3">
                @foreach (var gap in _gaps)
                {
                    <div class="card">
                        <div class="row-top between g-4 wrap">
                            <div class="stack g-2 grow" style="min-width:220px">
                                <div class="row g-2 wrap">
                                    <h4>@gap.SkillName</h4>
                                    <SapBadge Tone="@SeverityTone(gap.Severity)" Icon="@SeverityIcon(gap.Severity)">@gap.Severity</SapBadge>
                                    @if (gap.WeeksToClose > 0)
                                    {
                                        <SapBadge Tone="neutral" Icon="clock">@gap.WeeksToClose @(gap.WeeksToClose == 1 ? "week" : "weeks") at 6 hrs/week</SapBadge>
                                    }
                                </div>
                                <span class="t-small t-muted">@gap.Rationale</span>
                            </div>

                            <div class="stack g-2" style="min-width:230px">
                                <LinearBar Percent="gap.CurrentLevel" Label="You" ValueText="@gap.CurrentLevel.ToString()" Small />
                                <LinearBar Percent="gap.RequiredLevel" Label="Role needs" ValueText="@gap.RequiredLevel.ToString()" Small Tone="accent" />
                                @if (_view == "impact")
                                {
                                    <div class="row between g-3">
                                        <span class="t-caption t-subtle">Impact @gap.Impact/10</span>
                                        <span class="t-caption t-subtle">Effort @gap.Effort/10</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private readonly IReadOnlyList<SapSegmented<string>.Option> _views =
    [
        new("radar", "Radar"),
        new("impact", "Impact × effort"),
    ];

    private string _view = "radar";
    private IReadOnlyList<SkillGapDto>? _gaps;
    private SkillRadarDto? _radar;
    private IReadOnlyList<SkillDto> _skills = [];

    private IReadOnlyList<RadarChart.RadarSeries> Series => _radar is null
        ? []
        : [new($"{_radar.RoleName} needs", _radar.RoleTarget), new("You", _radar.You)];

    protected override async Task OnInitializedAsync()
    {
        _radar = await Gaps.GetRadarAsync();
        _skills = await Profiles.GetSkillsAsync();
        _gaps = await Gaps.GetGapsAsync();
    }

    private static string SeverityTone(string severity) => severity switch
    {
        "Critical" => "error",
        "Important" => "warn",
        "Closed" => "success",
        _ => "neutral",
    };

    private static string SeverityIcon(string severity) => severity switch
    {
        "Critical" => "alert-circle",
        "Important" => "alert-triangle",
        "Closed" => "check",
        _ => "info",
    };
}
