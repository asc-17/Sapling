@page "/paths/{Id:int}"
@namespace Sapling.Shared.Pages
@inject ICareerService Careers

<PageTitle>@(_path?.Title ?? "Career path") · Sapling</PageTitle>
<RecordVisit Feature="@FeatureCatalog.CareerPaths" />

@if (_path is null)
{
    <div class="card stack g-3">
        <div class="skeleton" style="height:28px;width:50%"></div>
        <div class="skeleton" style="height:120px"></div>
    </div>
}
else
{
    <div class="stack g-5">
        <a class="btn btn-ghost btn-sm" href="/paths" style="align-self:flex-start">
            <SapIcon Name="chevron-left" Size="15" />
            All paths
        </a>

        <div class="card">
            <div class="row-top g-6 wrap">
                <ScoreRing Value="_path.FitScore" Size="140" Caption="Fit score" Label="Fit" />
                <div class="grow stack g-3" style="min-width:260px">
                    <div class="row g-2 wrap">
                        <SapBadge Tone="primary">@_path.Tier</SapBadge>
                        <SapBadge Tone="neutral">@_path.Family</SapBadge>
                        <SapBadge Tone="success" Icon="trending-up">@_path.DemandTrend</SapBadge>
                    </div>
                    <h1 style="font-size:30px;line-height:36px">@_path.Title</h1>
                    <p class="t-muted">@_path.FiveYearOutlook</p>
                    <div class="row g-2 wrap">
                        <a class="btn btn-primary" href="/roadmap">Build the roadmap</a>
                        <a class="btn btn-secondary" href="/opportunities">See matching roles</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="grid grid-2">
            <SapCard Title="Why this path">
                <Header><WhyThisPopover Reasons="_path.Reasons" /></Header>
                <ChildContent>
                    <ul class="stack g-2" style="margin:0;padding-left:18px">
                        @foreach (var reason in _path.Reasons)
                        {
                            <li class="t-small">@reason</li>
                        }
                    </ul>
                </ChildContent>
            </SapCard>

            <SapCard Title="The counter-case" Subtitle="The argument against this path, stated honestly">
                <ChildContent>
                    <div class="card card-inset stack g-2">
                        <span class="row g-2 t-small" style="font-weight:600;color:var(--warn-text)">
                            <SapIcon Name="alert-triangle" Size="16" />
                            Devil's advocate
                        </span>
                        <span class="t-small">@(_path.CounterCase ?? "No significant counter-argument recorded for this path.")</span>
                    </div>
                </ChildContent>
            </SapCard>
        </div>

        <div class="grid grid-2">
            <SapCard Title="Salary bands">
                <ChildContent>
                    <div class="stack g-4">
                        <LinearBar Percent="45" Label="Entry, Madhya Pradesh" ValueText="@_path.EntrySalaryMp" />
                        <LinearBar Percent="78" Label="Entry, metro" ValueText="@_path.EntrySalaryMetro" />
                        <span class="t-caption t-subtle">
                            Metro figures assume relocation. Cost of living in Indore and Bhopal is roughly 40% lower,
                            so the local band is often the better real outcome.
                        </span>
                    </div>
                </ChildContent>
            </SapCard>

            <SapCard Title="Core skills" Subtitle="What this role actually asks for">
                <ChildContent>
                    <div class="row g-2 wrap">
                        @foreach (var skill in _path.CoreSkills)
                        {
                            <span class="chip">@skill</span>
                        }
                    </div>
                </ChildContent>
                <Footer>
                    <span class="t-caption t-subtle">Sample employers: @string.Join(", ", _path.Employers)</span>
                    <a class="btn btn-secondary btn-sm" href="/skills">Check your gaps</a>
                </Footer>
            </SapCard>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private CareerPathDto? _path;

    protected override async Task OnParametersSetAsync() => _path = await Careers.GetPathAsync(Id);
}
