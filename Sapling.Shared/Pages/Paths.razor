@page "/paths"
@namespace Sapling.Shared.Pages
@inject ICareerService Careers

<PageTitle>Career paths · Sapling</PageTitle>
<RecordVisit Feature="@FeatureCatalog.CareerPaths" />

<div class="stack g-5">
    <div class="page-head">
        <div class="stack g-1">
            <h1 style="font-size:28px;line-height:34px">Career paths</h1>
            <span class="t-muted">Ranked by fit, with the reasoning attached. Argue with it.</span>
        </div>
    </div>

    @if (_paths is null)
    {
        <div class="grid grid-3">
            @for (var i = 0; i < 3; i++)
            {
                <div class="card stack g-3">
                    <div class="skeleton" style="height:90px;width:90px;border-radius:50%"></div>
                    <div class="skeleton" style="height:18px;width:70%"></div>
                    <div class="skeleton" style="height:48px"></div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="grid grid-3">
            @foreach (var path in _paths)
            {
                <a class="card stack g-4" href="@($"/paths/{path.Id}")">
                    <div class="row between g-3">
                        <SapBadge Tone="@TierTone(path.Tier)">@path.Tier</SapBadge>
                        <span class="t-caption t-subtle">@path.Family</span>
                    </div>

                    <div class="row g-4">
                        <ScoreRing Value="path.FitScore" Size="86" Thickness="9" Label="Fit" />
                        <div class="stack grow" style="gap:2px">
                            <h4>@path.Title</h4>
                            <span class="t-caption t-subtle">Fit score</span>
                        </div>
                    </div>

                    <div class="stack g-2">
                        <div class="row between g-2">
                            <span class="t-caption t-subtle">Entry, Madhya Pradesh</span>
                            <span class="t-small" style="font-weight:600">@path.EntrySalaryMp</span>
                        </div>
                        <div class="row between g-2">
                            <span class="t-caption t-subtle">Entry, metro</span>
                            <span class="t-small" style="font-weight:600">@path.EntrySalaryMetro</span>
                        </div>
                        <div class="row between g-2">
                            <span class="t-caption t-subtle">Demand</span>
                            <span class="t-small" style="font-weight:600;color:var(--success-text)">@path.DemandTrend</span>
                        </div>
                    </div>

                    <span class="t-small t-muted">@path.Reasons.FirstOrDefault()</span>
                </a>
            }
        </div>
    }
</div>

@code {
    private IReadOnlyList<CareerPathDto>? _paths;

    protected override async Task OnInitializedAsync() => _paths = await Careers.GetPathsAsync();

    private static string TierTone(string tier) => tier switch
    {
        "Safe" => "success",
        "Stretch" => "primary",
        _ => "info",
    };
}
