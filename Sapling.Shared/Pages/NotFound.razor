@page "/not-found"
@namespace Sapling.Shared.Pages
@layout AppLayout
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization

<PageTitle>Not found · Sapling</PageTitle>

<SapEmptyState Title="That page does not exist"
               Description="The link may be out of date, or the feature may have moved."
               Icon="search">
    <a class="btn btn-primary" href="/home">Back to home</a>
</SapEmptyState>
