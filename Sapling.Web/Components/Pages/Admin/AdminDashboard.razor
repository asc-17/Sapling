@page "/admin"
@namespace Sapling.Web.Components.Pages.Admin
@layout AdminLayout
@attribute [Authorize]
@inject AdminService Admins

<PageTitle>Admin dashboard · Sapling</PageTitle>

<div class="stack g-5">
    <div class="page-head" style="margin-bottom:0">
        <div class="stack g-1">
            <h1 style="font-size:28px;line-height:34px">Platform overview</h1>
            <span class="t-muted">Who is on Sapling, and how that is changing.</span>
        </div>
    </div>

    @if (_data is null)
    {
        <div class="card"><div class="skeleton" style="height:220px"></div></div>
    }
    else
    {
        <div class="grid grid-4">
            <Stat Label="Students" Value="_data.Students" Icon="users"
                  Hint="@Blocked(_data.DeactivatedStudents)" />
            <Stat Label="Institutes" Value="_data.Institutes" Icon="building"
                  Hint="@Blocked(_data.DeactivatedInstitutes)" />
            <Stat Label="Administrators" Value="_data.Admins" Icon="shield-check" Hint="Platform staff" />
            <Stat Label="Colleges claimed" Value="_data.ClaimedColleges" Icon="check-circle"
                  Hint="@($"{_data.UnclaimedColleges} still unclaimed")" />
        </div>

        <div class="grid grid-2">
            <SapCard Title="New accounts" Subtitle="Signups in the last six months">
                @if (_data.SignupsByMonth.Sum(s => s.Count) == 0)
                {
                    <span class="t-small t-subtle">No signups recorded in this window.</span>
                }
                else
                {
                    <div class="stack g-2">
                        @foreach (var month in _data.SignupsByMonth)
                        {
                            <LinearBar Percent="Percent(month.Count, MaxSignups)" Label="@month.Label"
                                       ValueText="@month.Count.ToString()" Small />
                        }
                    </div>
                }
            </SapCard>

            <SapCard Title="Top colleges" Subtitle="By registered students">
                @if (_data.TopColleges.Count == 0)
                {
                    <span class="t-small t-subtle">No students have named a college yet.</span>
                }
                else
                {
                    <div class="stack g-2">
                        @foreach (var college in _data.TopColleges)
                        {
                            <LinearBar Percent="Percent(college.Count, MaxCollege)" Label="@college.Label"
                                       ValueText="@college.Count.ToString()" Small />
                        }
                    </div>
                }
            </SapCard>
        </div>
    }
</div>

@code {
    private AdminDashboardDto? _data;

    private int MaxSignups => Math.Max(1, _data!.SignupsByMonth.Max(s => s.Count));
    private int MaxCollege => Math.Max(1, _data!.TopColleges.Max(s => s.Count));

    protected override async Task OnInitializedAsync() => _data = await Admins.GetDashboardAsync();

    private static int Percent(int value, int max) => (int)Math.Round(value * 100.0 / max);

    private static string Blocked(int count) => count == 0 ? "All active" : $"{count} deactivated";
}
